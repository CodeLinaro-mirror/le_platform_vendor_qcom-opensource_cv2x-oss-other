    }
    instance commonapi.SPLITS.SplitsStatistics {
        InstanceId = "commonapi.SPLITS.SplitsStatistics"
        SomeIpInstanceID = 22138
        SomeIpUnicastAddress = "192.168.0.2"
        SomeIpReliableUnicastPort = 30499
        SomeIpUnreliableUnicastPort = 30499
    }
}

