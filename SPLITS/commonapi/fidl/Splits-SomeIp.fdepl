    }

    method getSPLITSStatus {
        SomeIpMethodID = 30300
        SomeIpReliable = false
    }

    method getTxStatistics:psid {
        SomeIpMethodID = 30301
        SomeIpReliable = false
    }

    method getTxStatistics:all {
        SomeIpMethodID = 30302
        SomeIpReliable = false
    }

    method getRxStatistics:port {
        SomeIpMethodID = 30303
        SomeIpReliable = false
    }

    method getRxStatistics:all {
        SomeIpMethodID = 30304
        SomeIpReliable = false
    }

    method getMsgStatistics:message_id {
        SomeIpMethodID = 30305
        SomeIpReliable = false
    }

    method getMsgStatistics:all {
        SomeIpMethodID = 30306
        SomeIpReliable = false
    }

    method getPSIDStatistics:psid {
        SomeIpMethodID = 30307
        SomeIpReliable = false
    }

    method getPSIDStatistics:all {
        SomeIpMethodID = 30308
        SomeIpReliable = false
    }

    method getSecurityReport {
        SomeIpMethodID = 30309
        SomeIpReliable = false
    }

    method getCongestionControlStatistics {
        SomeIpMethodID = 30310
        SomeIpReliable = false
    }
}



define org.genivi.commonapi.someip.deployment for provider as Service {
    instance commonapi.SPLITS.SplitsConfig {
        InstanceId = "commonapi.SPLITS.SplitsConfig"
        SomeIpInstanceID = 22136
        SomeIpUnicastAddress = "192.168.0.2"
        SomeIpReliableUnicastPort = 30499
        SomeIpUnreliableUnicastPort = 30499
    }
    instance commonapi.SPLITS.VehicleData {
        InstanceId = "commonapi.SPLITS.VehicleData"
