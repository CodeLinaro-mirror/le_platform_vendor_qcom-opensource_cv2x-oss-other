package commonapi.SPLITS

typeCollection SplitsCommon {
    version { major 1 minor 0 }

    enumeration FlowType {
        SPS
        EVENT
    }

    enumeration ErrorCode {
        V2X_SUSPEND
        V2X_INACTIVE
        ENCODE_FAIL
        DECODE_FAIL
        SIGN_FAIL
        VERIF_FAIL
        NOMEMORY
        OTHER
    }
}
